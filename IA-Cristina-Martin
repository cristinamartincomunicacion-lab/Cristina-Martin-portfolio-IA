    }
    .pill:hover{border-color:rgba(127,211,255,.5);color:var(--text)}
    .hero{padding:44px 6px 28px;display:grid;grid-template-columns: 1.25fr .75fr;gap:18px;align-items:stretch}
    @media (max-width: 900px){.hero{grid-template-columns:1fr}}
    h1{margin:0 0 10px;font-size:40px;letter-spacing:-.6px;line-height:1.08}
    .subtitle{color:var(--muted);font-size:16px;margin:0 0 22px}
    .ctaRow{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
    .btn{
      display:inline-flex;align-items:center;justify-content:center;gap:10px;
      padding:12px 14px;border-radius:12px;border:1px solid var(--border);
      background: rgba(255,255,255,.05);text-decoration:none;
      color:var(--text);font-weight:650;
    }
    .btn.primary{
      background: linear-gradient(135deg, rgba(127,211,255,.18), rgba(156,255,201,.12));
      border-color: rgba(127,211,255,.35);

    .btn:hover{transform: translateY(-1px)}
    .card{
      border:1px solid var(--border);
      border-radius: var(--radius);
      background: rgba(16,26,51,.62);
      box-shadow: var(--shadow);
      padding:18px;
    }
    .meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
    .tag{font-size:12px;color:var(--muted);border:1px solid var(--border);padding:7px 10px;border-radius:999px;background: rgba(255,255,255,.03)}
    .kpi{
      display:grid;grid-template-columns:1fr 1fr;gap:10px;
      height:100%;
    }
    .kpi .box{
      border:1px solid var(--border);border-radius:16px;padding:14px;background: rgba(255,255,255,.03);
    }
    .kpi .num{font-size:20px;font-weight:800}
    .kpi .lbl{font-size:12px;color:var(--muted);margin-top:4px}
    section{margin-top:18px}
    h2{margin:0 0 12px;font-size:18px;letter-spacing:-.2px}
    .grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    @media (max-width: 900px){.grid{grid-template-columns:1fr}}
    ul{margin:10px 0 0 18px;color:var(--muted)}
    li{margin:7px 0}
    .twoCol{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    @media (max-width: 900px){.twoCol{grid-template-columns:1fr}}
    .muted{color:var(--muted)}
    .footer{margin-top:22px;color:var(--muted);font-size:12px;text-align:center}
    .hr{height:1px;background: var(--border);margin:12px 0}
    .small{font-size:13px;color:var(--muted)}
    .callout{
